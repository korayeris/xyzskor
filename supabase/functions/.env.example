# Bu dosya yalnızca değişken adlarını belgeler. Gerçek anahtarları Git'e eklemeyin.
FOOTBALL_DATA_PROVIDER=sportmonks
API_FOOTBALL_KEY=
SPORTMONKS_API_TOKEN=
# Virgülle 5 seçili lig ID'si. Boş bırakılırsa backend aynı listeyi varsayılan kullanır.
# Süper Lig=600, UEFA Champions League=2, UEFA Europa League=5, La Liga=564, Premier League=8
SPORTMONKS_LEAGUE_IDS=600,2,5,564,8
LIVE_CACHE_LIVE_SECONDS=5
LIVE_CACHE_PREMATCH_SECONDS=120
LIVE_CACHE_IDLE_SECONDS=60
SEASON_CACHE_SECONDS=21600
LIVE_ALLOWED_ORIGINS=http://127.0.0.1:4173,http://localhost:4173
